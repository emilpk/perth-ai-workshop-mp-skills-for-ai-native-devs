{
  // Deploy from this folder: npx wrangler deploy (see README.md)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "perth-ai-skills-night",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "../docs", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // perthai.org is on the Perth AI Cloudflare account, so Wrangler can add this subdomain and its DNS on deploy
  "routes": [{ "pattern": "skills.perthai.org", "custom_domain": true }],
  "observability": { "enabled": true }
}
